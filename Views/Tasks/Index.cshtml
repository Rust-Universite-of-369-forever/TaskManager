@model List<TaskItem>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Задачи</h1>

    @if (ViewBag.IsAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">+ Создать задачу</a>
    }
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="status" class="form-select">
            <option value="">Все статусы</option>
            <option>Новая</option>
            <option>В работе</option>
            <option>Завершена</option>
        </select>
    </div>

    @if (ViewBag.IsAdmin)
    {
        <div class="col-md-4">
            <select name="userId" class="form-select">
                <option value="">Все исполнители</option>
                @foreach (var user in ViewBag.Users)
                {
                    <option value="@user.Id">@user.FullName</option>
                }
            </select>
        </div>
    }

    <div class="col-md-2">
        <button class="btn btn-secondary w-100">Фильтр</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Задач пока нет.</div>
}
else
{
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Название</th>
                <th>Исполнитель</th>
                <th>Приоритет</th>
                <th>Статус</th>
                <th>Срок</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var task in Model)
        {
            <tr class="@(task.IsOverdue ? "table-danger" : "")">
                <td>
                    <strong>@task.Title</strong>
                    <br />
                    <small>@task.Description</small>
                </td>
                <td>@(task.AssignedUser?.FullName ?? "Не назначен")</td>
                <td>
                    @Html.PriorityBadge(task.Priority)
                    @Html.DueDateBadge(task)
                </td>
                <td>@task.Status</td>
                <td>@task.DueDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (ViewBag.IsAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@task.Id"
                           class="btn btn-sm btn-warning">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@task.Id"
                           class="btn btn-sm btn-danger">Удалить</a>
                    }
                    else
                    {
                        <form asp-action="ChangeStatus" method="post" class="d-flex gap-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@task.Id" />
                            <select name="status" class="form-select form-select-sm">
                                <option>Новая</option>
                                <option>В работе</option>
                                <option>Завершена</option>
                            </select>
                            <button class="btn btn-sm btn-primary">OK</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
